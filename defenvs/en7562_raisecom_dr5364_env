loadaddr=0x89400000
ipaddr=192.168.1.1
serverip=192.168.1.254
netmask=255.255.255.0
dhcpd_verbose=1
bootled_pwr=green:power
failsafe_led_idle=green:power on;red:wan on;green:wan on;green:lan on;red:wps on;green:mesh on;green:wifi on
failsafe_led_ready=green:power blink 2000,green:wifi blink 2000
failsafe_led_upgrade=red:wan on,green:power on;red:wan on,green:wan on;red:wan on,green:lan on;red:wan on,green:mesh on;red:wan on,green:wifi on;red:wan on,red:wps on
failsafe_led_success=green:power on,green:wan on,green:lan on,green:mesh on,green:wifi on
failsafe_led_fail=red:wan blink 100,red:wps blink 100

bootconf=config-1
bootfile=openwrt-airoha-en7523-raisecom_dr5364-initramfs-kernel.bin
bootloaderfile=en7523_raisecom_dr5364-bl1-bl2-bl31-uboot.bin

boot_tftp=tftpboot $loadaddr $bootfile && bootm $loadaddr#$bootconf
ubi_read_openwrt=ubi read $loadaddr fit && iminfo $loadaddr

boot_openwrt=led $bootled_pwr blink 255; run ubi_read_openwrt && bootm $loadaddr#$bootconf ; led $bootled_pwr on ; echo Install openwrt ; run boot_tftp
boot_ubi=ubi part ubi && run boot_openwrt

upgrade_uboot=\
  mw.b 0x8964044e 0xff 0x100000 && tftpboot 0x8964044e ${bootloaderfile} && \
  mtd erase u-boot && mtd write u-boot 0x8964044e

failsafe_fit=setenv failsafe_part fit ; httpd
failsafe_uboot=setenv failsafe_part u-boot ; httpd

format_ubi_part=\
  mtd erase ubi && ubi part ubi && \
  ubi create ubootenv 0x40000 static && \
  ubi create ubootenv2 0x40000 static && \
  ubi create art 0x240000 && \
  ubi create rootfs_data -dynamic

bootcmd=run boot_ubi
bootdelay=3
bootmenu_confirm_return=askenv - Press ENTER to return to menu ; bootmenu 20
bootmenu_default=0
bootmenu_delay=3
bootmenu_title=      [0;34m( ( ( [1;39mOpenWrt[0;34m ) ) )[0m
bootmenu_0=Run default boot command.=run boot_openwrt
bootmenu_1=Boot system via TFTP.=run boot_tftp ; run bootmenu_confirm_return
bootmenu_2=Format UBI partition.=ubi info ubi || run format_ubi_part
bootmenu_3=[31mLoad U-Boot FIP via TFTP then write to NAND[0m=run upgrade_uboot
bootmenu_4=[32mStart Web failsafe.[0m=httpd
bootmenu_5=Reboot.=reset
