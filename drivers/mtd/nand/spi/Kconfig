menuconfig MTD_SPI_NAND
	bool "SPI NAND device Support"
	depends on DM_MTD && DM_SPI
	select DEVRES
	select MTD_NAND_CORE
	select SPI_MEM
	help
	  This is the framework for the SPI NAND device drivers.

config MTD_SPI_NAND_DEVICE_AUTOSELECT
	bool "Autoselect SPI Nand flash"
	default y
	help
	  By default, auto-selects frequent used SPI Nand flash.
	  Enable by default: ESMT, ETRON, FMSH, FORESEE, GIGADEVICE,
	  MACRONIX, MICRON, PARAGON, SKYHIGH, TOSHIBA, WINBOND, XTX.
	  Disable by default: ALLIANCEMEMORY, ATO.
	  If you want to add support for more SPI Nand flash chips,
	  please enable the corresponding option below.

config MTD_SPI_NAND_ALLIANCEMEMORY
	bool "ALLIANCEMEMORY SPI flash support"
	depends on MTD_SPI_NAND
	default n
	help
	  Add support for various ALLIANCEMEMORY SPI Nand flash chips

config MTD_SPI_NAND_ATO
	bool "ATO SPI flash support"
	depends on MTD_SPI_NAND
	default n
	help
	  Add support for various ATO SPI Nand flash chips

config MTD_SPI_NAND_ESMT
	bool "ESMT SPI flash support"
	depends on MTD_SPI_NAND
	default y if MTD_SPI_NAND_DEVICE_AUTOSELECT
	help
	  Add support for various ESMT SPI Nand flash chips

config MTD_SPI_NAND_ETRON
	bool "ETRON SPI flash support"
	depends on MTD_SPI_NAND
	default y if MTD_SPI_NAND_DEVICE_AUTOSELECT
	help
