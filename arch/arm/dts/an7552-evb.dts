/dts-v1/;

#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/leds/common.h>
#include "an7563-evb.dts"

/ {
	model = "Airoha AN7552 Evaluation Board";
	compatible = "airoha,an7552-evb", "airoha,an7552-evb",
		     "airoha,an7552", "airoha,an7563";

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pinctrl 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "green:regist";
			gpios = <&pinctrl 2 GPIO_ACTIVE_LOW>;
		};

		led-1 {
			label = "red:pon";
			gpios = <&pinctrl 12 GPIO_ACTIVE_LOW>;
		};

		led-3 {
			label = "green:lan1";
			gpios = <&pinctrl 8 GPIO_ACTIVE_LOW>;
		};

		led-4 {
			label = "green:lan2";
			gpios = <&pinctrl 9 GPIO_ACTIVE_LOW>;
		};

		led-5 {
			label = "green:lan";
			gpios = <&pinctrl 10 GPIO_ACTIVE_LOW>;
		};

		led-6 {
			label = "green:lan";
			gpios = <&pinctrl 11 GPIO_ACTIVE_LOW>;
		};
	};
};
