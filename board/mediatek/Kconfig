if ARCH_MEDIATEK || ARCH_MTMIPS

menu "Mediatek specific configurations"

menu "Mediatek Failsafe Web recovery"

config MTK_WEB_FAILSAFE
	bool "Enable failsafe Web recovery"
	select WEBUI_FAILSAFE
	help
	  Enable the Mediatek failsafe Web recovery feature.

menuconfig MTK_FAILSAFE_VALIDATE
	bool "Enable failsafe image validation"
	depends on MTK_WEB_FAILSAFE
	help
	  Master switch for all structural image validation performed by
	  the failsafe Web recovery before flashing (failsafe_validate.c).

	  Independently of this compile-time switch, the runtime
	  environment variable "failsafe_validate" can disable the
	  structural validation on a running device (set it to 0/no);
	  the generic storage capacity checks are always performed.

if MTK_FAILSAFE_VALIDATE

if ARM

config MTK_FAILSAFE_VALIDATE_BL2
	bool "Validate 'bl2' (preloader) images"
	default y
	help
	  Structurally validate uploaded 'bl2' images before they are
	  flashed.

config MTK_FAILSAFE_VALIDATE_FIP
	bool "Validate 'fip' images"
	default y
	help
	  Structurally validate uploaded 'fip' (UBI static volume) images
	  before they are flashed.

	  The U-Boot the FIP ships is also checked against this board (the
	  'compatible' of the device tree U-Boot carries must match),
	  unless the environment variable "failsafe_strict_model" is set
	  to 0 on the running device.  A U-Boot stored compressed inside
	  the FIP (XZ, when MediaTek FIP compression is enabled) is
	  expanded first, which needs CONFIG_XZ; without the decoder the
	  check is skipped.

endif # ARM

config MTK_FAILSAFE_VALIDATE_UBOOT
	bool "Validate 'u-boot' images (MIPS: SPL / payload + U-Boot)"
	depends on MIPS && OF_LIBFDT
	default y
	help
	  Validate uploaded 'u-boot' images before they are flashed.

	  The MIPS SoCs have no FIP: the 'u-boot' storage holds the whole
	  bootloader image, with the U-Boot inside it - SPL + U-Boot
	  packed as a legacy uImage (u-boot-with-spl.bin, u-boot-lzma.img)
	  on MediaTek MIPS, a TCBoot loader with the U-Boot payload behind
	  it on EcoNet.
	  
	  Such an image is accepted only when it carries a
	  U-Boot - a valid legacy uImage (header and data CRC), or its
	  control device tree.  This part is structural and deliberately
	  strict, because this storage has no other guard (there is no FIP
	  ToC to validate); it is not affected by "failsafe_strict_model",
	  only by the master "failsafe_validate" switch (or by disabling
	  this option).

	  The 'compatible' list of that device tree is then compared with
	  the one of the running U-Boot, entry by entry, with the shorter
	  list having to be a prefix of the longer one (the same rule the
	  reference implementation applies) - so a bootloader built for
	  another board is rejected even when it shares this SoC.  The
	  environment variable "failsafe_strict_model" (on by default, 0
	  disables it) turns that comparison off.

	  A U-Boot stored compressed (LZMA on MediaTek MIPS) is expanded
	  first, which needs CONFIG_LZMA; without the decoder the board
	  comparison is skipped while the U-Boot itself still has to be
	  there.

config MTK_FAILSAFE_VALIDATE_FIRMWARE
	bool "Validate 'firmware' images"
	depends on FIT
	default y
	help
	  Validate uploaded 'firmware' images (OpenWrt kernel/rootfs FIT,
	  UBI volume) with the FIT checker (fit_check_format) before
	  they are flashed.

endif # MTK_FAILSAFE_VALIDATE

endmenu # Mediatek Failsafe Web recovery

config MTK_DEFAULT_FIT_BOOT_CONF
	string "Default boot configuration of FIT image"
	default ""
	help
	  FIT image can store multiple boot configuration to allow one sinle
	  FIT image to be used on multiple boards.
	  If left empty, the default one specified in FIT will be used.

endmenu # Mediatek specific configurations

endif # ARCH_MEDIATEK || ARCH_MTMIPS
